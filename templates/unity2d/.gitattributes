*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.tif binary
*.gif binary
*.bmp binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.fbx binary
*.obj binary
*.ttf binary
*.otf binary
*.dll binary
*.exe binary
*.so binary
*.a binary
*.unitypackage binary
