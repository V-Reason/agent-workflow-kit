# --- Python 运行时 ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
wheels/

# --- 虚拟环境与工具链 ---
.venv/
venv/
uv.lock
# 注：若决定锁定依赖，可删除上一行把 uv.lock 纳入版本控制（推荐应用类项目锁定）
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- 环境与密钥（绝不入库） ---
.env
.env.*
!.env.example

# --- 编辑器与系统 ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- 本地产物 ---
logs/
*.log
tmp/
output/

